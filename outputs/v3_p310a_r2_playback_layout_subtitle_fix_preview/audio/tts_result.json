        "pause_after": 0.24,
        "emphasis_words": []
      },
      {
        "sentence_id": "S03",
        "text": "一开始我只是想找个工具帮我写代码，结果用它做自媒体创作比写代码还顺手",
        "start": 10.8,
        "end": 17.61,
